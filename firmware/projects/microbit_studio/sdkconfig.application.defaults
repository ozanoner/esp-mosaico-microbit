# Keep the OTA writer only in the retained factory Recovery image. The normal
# application exposes the enter-Recovery RPC through iris_ota_support_start().
# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico microbit_studio"
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000

# GSP image cache. The studio scene keeps three rasters live (micro:bit footer,
# bear, trophy) and the trophy animation peaks at 165.9 KiB of decoded frames
# (gspc report for this scene), so the automatic budget must be able to grow
# past the 64 KiB default floor without relying on late eviction.
CONFIG_ESP_GSP_IMAGE_CACHE_AUTO_MIN_BYTES=65536
CONFIG_ESP_GSP_RENDER_TASK_STACK_PSRAM=y
CONFIG_ESP_GSP_DECODE_TASK_STACK_PSRAM=y
CONFIG_ESP_GSP_ANIM_FRAME_MEMORY_SPIRAM=y

# One verify round for normal use. Gate G4 runs override this to 10 when
# proving the link survives repeated cycles without a manual reset.
CONFIG_MB_BLE_POC_CYCLES=1
