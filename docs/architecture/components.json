  "cards": [
    {
      "dot": "cyan",
      "title": "One event type, one consumer",
      "items": [
        "mb_event_t is the only thing voice, build client and BLE central emit",
        "app_studio is the only consumer, so the screen layer stays replaceable",
        "mb_payload is the C port of tools/hexkit; the host tests pin both"
      ]
    },
    {
      "dot": "emerald",
      "title": "Vendor code stays outside",
      "items": [
        "firmware/submodule/esp-mosaico-utils and -bsp are pinned gitlinks",
        "Local fixes ship as firmware/patches/*.patch, never as submodule edits",
        "app_display is the only component that touches the BSP"
      ]
    }
  ]
