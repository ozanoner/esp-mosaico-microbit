    {
      "dot": "cyan",
      "title": "Where the image comes from",
      "items": [
        "Region 2 is 0x30000-0x3BBFF; the real start comes from the DAL magic address",
        "The device never parses Intel HEX: /v1/build?region2=true returns the bytes",
        "The DAL hash must match the board, or the write is refused"
      ]
    },
    {
      "dot": "emerald",
      "title": "Reproducibility gate",
      "items": [
        "make verify rebuilds hello.ts and compares against microbit/golden/expected.json",
        "templates hash 08d9ef69, program hash 8f007d00, 96 blocks at 0x37400",
        "Runs in CI on a published release and on demand only"
      ]
    }
