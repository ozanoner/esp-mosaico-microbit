  "cards": [
    {
      "dot": "cyan",
      "title": "The table is strict on purpose",
      "items": [
        "A state accepts only the event that moves it to the next step; anything else is dropped",
        "That is what stops a stale report from a previous cycle repainting a finished screen",
        "FAILED is refused from LISTENING: while the button is held, nothing is in flight",
        "AWAIT_MICROBIT can go straight to VERIFYING when the board already holds the program: nothing is written, so no FLASHING is emitted"
      ]
    },
    {
      "dot": "emerald",
      "title": "Both terminal states time out",
      "items": [
        "DONE dwells 10 s, FAILED 8 s, then return_to_idle re-arms the AI button",
        "A new press works from IDLE, DONE or FAILED without waiting out the dwell"
      ]
    }
  ]
