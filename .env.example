# Copy to .env and fill in. .env is gitignored and dockerignored.
#
# A fine-grained PAT needs, on this repository: Contents read/write,
# Pull requests read/write, Issues read/write, Metadata read, and
# Workflows read/write if the CI file is to be pushed.
GITHUB_TOKEN=github_pat_replace_me
GITHUB_REPO=ozanoner/esp-mosaico-microbit

# ASR and LLM for POST /v1/idea. Keys live here only: never in the repo, never
# on the device. Any OpenAI-compatible base URL works (openai, a local vLLM,
# a LAN gateway), so swapping providers is an .env change, not a code change.
MB_ASR_BASE_URL=https://api.openai.com/v1
MB_ASR_API_KEY=
MB_ASR_MODEL=whisper-1

MB_LLM_BASE_URL=https://api.openai.com/v1
MB_LLM_API_KEY=
MB_LLM_MODEL=gpt-4o-mini
