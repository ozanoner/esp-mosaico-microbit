# Copy to .env and fill in what you need. .env is gitignored and dockerignored, so
# it can never reach a commit or a build context.
#
# To RUN the project you need exactly one value: an LLM key.
# Everything below the LLM block is optional or development-only.

# --- LLM: writes the MakeCode program (required for POST /v1/speak) ---------
# Any OpenAI-compatible endpoint works (OpenAI, DeepSeek, a local vLLM, a LAN
# gateway), so swapping providers is an .env change, not a code change.
# The defaults in compose.yaml are DeepSeek's.
MB_LLM_BASE_URL=https://api.deepseek.com
MB_LLM_API_KEY=
MB_LLM_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=            # accepted too, and treated as MB_LLM_API_KEY

# --- ASR: optional ---------------------------------------------------------
# By default speech-to-text runs in the `asr` sidecar on the compose network and
# needs no credential and no setting at all. Uncomment these to use a hosted
# transcriber instead.
# MB_ASR_BASE_URL=https://api.openai.com/v1
# MB_ASR_API_KEY=
# MB_ASR_MODEL=whisper-1

# --- Development only ------------------------------------------------------
# Only for git/gh from this checkout. Nothing in the project reads these.
# Not here: the firmware's Wi-Fi and build-box URL. Those are compiled in via
# Kconfig in the generated build/sdkconfig — see the Credentials section of the
# README.
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=ozanoner/esp-mosaico-microbit
